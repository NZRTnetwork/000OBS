
# Podcast media - YouTube hosts these; GitHub keeps manifest + captions only
POD-obs/*.mp3
POD-obs/*.mp4
POD-obs/MP3/
POD-obs/IMG/
POD-obs/MP4/
!POD-obs/manifest.csv
!POD-obs/*.srt

__pycache__/
*.pyc

# Obsidian workspace state — user-specific, don't commit
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Keep plugin list and appearance settings (useful to share)
# .obsidian/community-plugins.json  ← intentionally not ignored
# .obsidian/app.json                ← intentionally not ignored

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment / credentials
.env
*.env.local
CREDS/
